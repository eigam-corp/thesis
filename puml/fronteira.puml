@startuml Diagrama de Fronteira Sistemica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 70
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #555555
skinparam dpi 150

skinparam rectangle {
    BorderColor #333333
    BorderThickness 2
    FontStyle bold
    FontSize 14
}

skinparam package {
    BorderColor #888888
    BorderThickness 1
    FontSize 12
}

skinparam component {
    BackgroundColor #F5F5F5
    BorderColor #666666
    FontSize 11
}

skinparam database {
    BackgroundColor #F5F5F5
    BorderColor #666666
    FontSize 11
}

actor "Titular" as USR
actor "Equipe de\noperação" as OPS

package "Mensageria" #FDECEA {
    component "WhatsApp\nCloud API (Meta)" as WA
    component "Telegram\nBot API" as TG
}

package "Open Finance" #E8F5E9 {
    component "Pluggy" as PLUGGY
}

package "Inteligência artificial" #EDE7F6 {
    component "OpenAI\n(LLM e transcrição)" as AI
    component "TypeSafe\n(juízo tipado)" as JEV
}

package "Pagamentos" #FFF8E1 {
    component "Stripe" as STRIPE
}

package "Borda" #E3F2FD {
    component "Cloudflare\n(proxy, túnel, Access)" as CF
}

rectangle "  EIGAM  " as SYS #FFFFFF {

    package "Entrada e painéis" {
        component "API Gateway" as GW
        component "Painel do titular" as HP
        component "Painel de operação" as AP
    }

    package "Conversa e IA" {
        component "Chat Service" as CS
        component "AI Service" as AIS
        component "Identity Service" as IDS
    }

    package "Finanças" {
        component "Finance Service" as FS
        component "Analytics Service" as ANS
    }

    package "Comunicação e plataforma" {
        component "Notification Service" as NS
        component "Render Service" as RS
        component "Outbound Worker" as OW
        component "Billing Service" as BS
        component "Audit Service" as AUD
    }

    package "Dados" {
        queue "Redpanda\n(API Kafka)" as KF
        database "PostgreSQL\n(pgvector, pgcrypto)" as PG
        database "MongoDB" as MG
        database "Redis" as RD
    }

    GW --> KF
    KF --> CS
    KF --> NS
    KF --> OW
    KF --> BS
    KF --> AUD
    KF --> ANS
    CS --> AIS
    CS --> IDS
    CS --> FS
    CS --> RD
    NS --> RS
    FS --> MG
    FS --> PG
    IDS --> PG
    HP --> IDS
    AP --> CS
}

USR --> WA : mensagem
USR --> TG : mensagem
USR --> CF : navegador
OPS --> CF : navegador
CF --> GW
CF --> HP
CF --> AP
WA --> GW : webhook (HMAC)
TG --> GW : webhook (segredo)
OW --> WA : resposta
OW --> TG : resposta
FS --> PLUGGY : sincronização
PLUGGY --> GW : webhook
AIS --> AI : planejamento e redação
AIS --> JEV : guardrails
BS --> STRIPE : assinaturas
STRIPE --> GW : webhook

@enduml
