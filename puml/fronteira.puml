@startuml Diagrama de Fronteira Sistemica
skinparam packageStyle rectangle
skinparam monochrome true
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 70
skinparam defaultFontSize 15
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam ArrowColor Black
skinparam ArrowThickness 1.4
skinparam dpi 220

skinparam rectangle {
    BorderColor Black
    BorderThickness 2
    FontStyle bold
    FontSize 17
}

skinparam package {
    BorderColor Black
    BorderThickness 1
    FontSize 15
}

skinparam component {
    BackgroundColor White
    BorderColor Black
    FontSize 14
}

skinparam database {
    BackgroundColor White
    BorderColor Black
    FontSize 14
}

actor "Titular" as USR
actor "Equipe de\noperação" as OPS

package "Mensageria" {
    component "API oficial\ndo WhatsApp" as WA
    component "API oficial\ndo Telegram" as TG
}

package "Open Finance" {
    component "Agregador de dados\n(Open Finance)" as PLUGGY
}

package "Inteligência artificial" {
    component "Provedor de LLM\n(planejamento, redação\ne transcrição)" as AI
    component "Provedor do modelo\nde juízo tipado" as JEV
}

package "Assistentes de IA do titular" {
    component "Cliente MCP\n(assistente externo)" as EXT
}

package "Pagamentos" {
    component "Provedor de\npagamentos" as STRIPE
}

package "Borda" {
    component "Serviço de borda\n(proxy, túnel e\nautenticação)" as CF
}

rectangle "  EIGAM  " as SYS {

    package "Entrada e painéis" {
        component "API Gateway" as GW
        component "Painel do titular" as HP
        component "Painel de operação" as AP
        component "MCP Service" as MCP
    }

    package "Conversa e IA" {
        component "Chat Service" as CS
        component "AI Service" as AIS
        component "Identity Service" as IDS
    }

    package "Finanças" {
        component "Finance Service" as FS
        component "Analytics Service" as ANS
    }

    package "Comunicação e plataforma" {
        component "Notification Service" as NS
        component "Render Service" as RS
        component "Outbound Worker" as OW
        component "Billing Service" as BS
        component "Audit Service" as AUD
    }

    package "Dados" {
        queue "Broker de eventos\n(API Kafka)" as KF
        database "PostgreSQL\n(pgvector, pgcrypto)" as PG
        database "MongoDB" as MG
        database "Redis" as RD
    }

    GW --> KF
    KF --> CS
    KF --> NS
    KF --> OW
    KF --> BS
    KF --> AUD
    KF --> ANS
    CS --> AIS
    CS --> IDS
    CS --> FS
    CS --> RD
    NS --> RS
    FS --> MG
    FS --> PG
    IDS --> PG
    HP --> IDS
    AP --> CS
    MCP --> IDS
    MCP --> FS
}

USR --> WA : mensagem
USR --> TG : mensagem
USR --> CF : navegador
OPS --> CF : navegador
CF --> GW
CF --> HP
CF --> AP
CF --> MCP
EXT --> CF : OAuth 2.1 e\nleitura (MCP)
WA --> GW : webhook (HMAC)
TG --> GW : webhook (segredo)
OW --> WA : resposta
OW --> TG : resposta
FS --> PLUGGY : sincronização
PLUGGY --> GW : webhook
AIS --> AI : planejamento e redação
AIS --> JEV : guardrails
BS --> STRIPE : assinaturas
STRIPE --> GW : webhook

@enduml
