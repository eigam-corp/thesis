@startuml UC02 - Analise Preditiva e Alertas
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Usuário" as U
actor "Sistema\n(Scheduler)" as SYS
actor "Pluggy\n(Open Finance)" as PL

rectangle "Análise Preditiva e Alertas" {
    usecase "Receber alerta\nde gasto atípico" as UC10
    usecase "Receber alerta\nde saldo baixo" as UC11
    usecase "Receber alerta\nde vencimento" as UC12
    usecase "Consultar projeção\nde gastos futuros" as UC13
    usecase "Detectar transações\nrecorrentes" as UC14
    usecase "Classificar\ntransações por categoria" as UC15
    usecase "Sincronizar\ntransações automaticamente" as UC16
    usecase "Receber alerta\nde progresso de meta" as UC17
}

U --> UC10
U --> UC11
U --> UC12
U --> UC13
U --> UC17

SYS --> UC16
SYS --> UC10 : dispara se desvio > 2σ
SYS --> UC11 : dispara se projeção\nnegativa em 7 dias
SYS --> UC12 : dispara por recorrência\nidentificada

UC16 --> PL : busca a cada 6h
UC16 ..> UC15 : <<include>>
UC16 ..> UC14 : <<include>>
UC13 ..> UC16 : <<include>>

UC10 ..> UC16 : <<include>>
UC11 ..> UC16 : <<include>>

note bottom of UC15
  Classificação automática
  via regras MCC + LLM
  para casos ambíguos.
end note

note bottom of UC16
  Job BullMQ agendado a cada 6h
  por usuário com consentimento ativo.
  Máx. 500 transações por sync.
end note
@enduml
