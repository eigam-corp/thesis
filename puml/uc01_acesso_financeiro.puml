@startuml UC01 - Acesso e Consulta Financeira
left to right direction
skinparam packageStyle rectangle
skinparam monochrome true
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontSize 16
skinparam ArrowThickness 1.4

actor "Usuário" as U
actor "Agregador\n(Open Finance)" as PL
actor "Provedor\nde LLM" as AI

rectangle "Acesso e Consulta Financeira" {
    usecase "Realizar cadastro\npela conversa" as UC01
    usecase "Vincular conta\nao Open Finance" as UC02
    usecase "Autenticar via\nPIN de 6 dígitos" as UC03
    usecase "Consultar saldo\ne extrato" as UC04
    usecase "Consultar histórico\nde transações" as UC05
    usecase "Consultar resumo\nfinanceiro" as UC06
    usecase "Receber resposta\nem linguagem natural" as UC07
    usecase "Visualizar gráfico\nde gastos" as UC08
    usecase "Obter token\nde privilégio (8h)" as UC09
    usecase "Acessar o painel\ndo titular" as UC28
}

U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC06
U --> UC28

UC04 ..> UC03 : <<include>>
UC05 ..> UC03 : <<include>>
UC06 ..> UC03 : <<include>>

UC04 ..> UC07 : <<include>>
UC05 ..> UC07 : <<include>>
UC06 ..> UC07 : <<include>>
UC06 ..> UC08 : <<extend>>

UC03 ..> UC09 : <<include>>

UC02 --> PL
UC07 --> AI : planeja e redige

note right of UC09
  Token de 8h, ajustável de 1 a 24h.
  Sem token: valores mascarados
  (R$ •••••) na conversa e no painel;
  imagens não são enviadas.
end note

note right of UC03
  PIN guardado apenas como
  hash criptográfico.
  Bloqueio de 30 min
  após 5 falhas.
end note

note right of UC01
  Pela conversa: aceite dos termos,
  nome, CPF, e-mail e PIN.
end note

note right of UC28
  Entrada por código enviado
  ao WhatsApp ou por link
  de uso único da conversa.
end note
@enduml
