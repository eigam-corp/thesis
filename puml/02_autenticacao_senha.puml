@startuml 02 - Autenticação por Senha e Token de Privilégio
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180

actor Usuário as U
participant "WhatsApp\n(Meta)" as WA
participant "Nginx\n(Ingress)" as NG
participant "API Gateway" as GW
participant "Kafka\nmessages.inbound" as K1
participant "Chat Service" as CS
participant "PostgreSQL" as PG
participant "Redis" as RD
participant "Kafka\nmessages.outbound" as K2
participant "Outbound Worker" as OW
participant "Kafka\naudit.log" as KA

== Solicitação de dados monetários ==

U -> WA : "qual meu saldo?"
WA -> NG : POST /webhook (HMAC-SHA256)
NG -> GW : Valida assinatura HMAC
GW -> K1 : Produz evento messages.inbound
GW --> WA : HTTP 200

K1 -> CS : Consome evento
CS -> RD : GET token:priv:{user_id}
RD --> CS : (nil) — token inexistente ou expirado

CS -> RD : GET lockout:{user_id}
RD --> CS : (nil) — sem bloqueio ativo

== Solicitação da senha ==

CS -> K2 : Produz mensagem:\n"Digite sua senha de 6 dígitos\npara acessar dados financeiros."
K2 -> OW : Consome evento
OW -> WA : Solicita senha ao usuário
WA -> U : "🔒 Digite sua senha de 6 dígitos:"

U -> WA : Digita a senha de 6 dígitos
WA -> NG : POST /webhook
NG -> GW : Valida HMAC
GW -> K1 : Produz evento
GW --> WA : HTTP 200

K1 -> CS : Consome evento (senha digitada)

CS -> RD : INCR rate:fail:{user_id}
RD --> CS : contador de falhas consecutivas

CS -> PG : SELECT pin_hash FROM users\nWHERE id = user_id
PG --> CS : bcrypt hash da senha cadastrada

CS -> CS : bcrypt.compare(senha_digitada, pin_hash)

alt Senha válida
    CS -> RD : DEL rate:fail:{user_id}
    CS -> CS : Gera token opaco\ncrypto.randomBytes(32).toString('hex')
    CS -> RD : SET token:priv:{user_id} {token} EX 3600\n(TTL 1 hora)
    CS -> KA : Produz audit.log\n(operation: auth_success)
    CS -> K2 : Produz resposta com\ndados monetários completos
    K2 -> OW : Consome evento
    OW -> WA : Envia resposta com valores reais
    WA -> U : "Saldo: R$ 2.450,00"

else Senha inválida
    CS -> RD : INCR rate:fail:{user_id} EX 900\n(janela de 15 minutos)
    RD --> CS : contador atualizado

    CS -> KA : Produz audit.log\n(operation: auth_failure)

    alt Menos de 5 falhas consecutivas
        CS -> K2 : Produz mensagem de erro
        K2 -> OW : Consome evento
        OW -> WA : Envia aviso
        WA -> U : "Senha incorreta. Tente novamente."

    else 5 ou mais falhas — lockout
        CS -> RD : SET lockout:{user_id} 1 EX 1800\n(bloqueio de 30 minutos)
        CS -> RD : DEL rate:fail:{user_id}
        CS -> KA : Produz audit.log\n(operation: auth_lockout)
        CS -> K2 : Produz mensagem de bloqueio
        K2 -> OW : Consome evento
        OW -> WA : Envia aviso de bloqueio
        WA -> U : "🔒 Muitas tentativas incorretas.\nAcesso bloqueado por 30 minutos."
    end
end
@enduml
