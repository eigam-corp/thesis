@startuml der_postgres
skinparam defaultFontName Arial
skinparam shadowing false
skinparam dpi 150
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 45
hide circle
hide members
hide methods
left to right direction
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #555555
    FontSize 11
}
skinparam package {
    BorderColor #888888
    FontSize 12
}

package "Identity Service" #EAF2FB {
    entity users
    entity user_channels
    entity data_deletion_requests
    entity user_data_exports
    entity operators
    entity operation_parameters
    entity operation_parameter_changes
    entity access_grants
    entity access_requests
    entity lead_lists
    entity lead_list_members
    entity holder_feedback
}

package "Finance Service" #EAF7EA {
    entity consents
    entity financial_goals
    entity saved_amount_entries
    entity financial_embeddings
    entity user_classification_overrides
    entity user_data_versions
    entity budget_alert_states
    entity signal_states
}

package "Billing Service" #FFF6E5 {
    entity subscriptions
    entity billing_events
    entity usage_prices
    entity exchange_rates
    entity usage_costs
}

package "Notification Service" #FCEBEF {
    entity campaigns
    entity campaign_recipients
    entity periodic_summaries
    entity summary_documents
    entity summary_document_receipts
    entity summary_activity
    entity summary_conversations
    entity summary_delivery_receipts
    entity alert_signals
    entity alert_notifications
    entity alert_data_versions
    entity alert_delivery_receipts
}

package "Audit Service" #F2F2F2 {
    entity audit_logs
}

users ||--o{ user_channels
users ||--o{ data_deletion_requests
users ||--o{ user_data_exports
users |o--o| operators
