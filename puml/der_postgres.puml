periodic_summaries ||--o{ summary_documents
users ||--o{ summary_document_receipts
users ||--o| user_data_versions
users ||--o{ budget_alert_states
users ||--o{ signal_states

users ||--o{ subscriptions
subscriptions ||--o{ billing_events
users ||--o{ usage_costs
usage_prices ||--o{ usage_costs

campaigns ||--o{ campaign_recipients
