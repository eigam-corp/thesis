@startuml der_postgres
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam monochrome true
skinparam dpi 220
skinparam defaultFontSize 15
skinparam ArrowThickness 1.3
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 45
hide circle
hide members
hide methods
left to right direction
skinparam class {
    BackgroundColor White
    BorderColor Black
    FontSize 15
}
skinparam package {
    BorderColor Black
    FontSize 16
}

package "Identity Service" {
    entity users
    entity user_channels
    entity data_deletion_requests
    entity user_data_exports
    entity operators
    entity operation_parameters
    entity operation_parameter_changes
    entity access_grants
    entity access_requests
    entity lead_lists
    entity lead_list_members
    entity holder_feedback
    entity oauth_clients
    entity assistant_connections
}

package "Finance Service" {
    entity consents
    entity financial_goals
    entity saved_amount_entries
    entity financial_embeddings
    entity user_classification_overrides
    entity user_data_versions
    entity budget_alert_states
    entity signal_states
    entity financial_write_attempts
}

package "Billing Service" {
    entity subscriptions
    entity billing_events
    entity usage_prices
    entity exchange_rates
    entity usage_costs
    entity plans
    entity plan_prices
}

package "Notification Service" {
    entity campaigns
    entity campaign_recipients
    entity periodic_summaries
    entity summary_documents
    entity summary_document_receipts
    entity summary_activity
    entity summary_conversations
    entity summary_delivery_receipts
    entity alert_signals
    entity alert_notifications
    entity alert_data_versions
    entity alert_delivery_receipts
}

package "Audit Service" {
    entity audit_logs
}

users ||--o{ user_channels
users ||--o{ data_deletion_requests
users ||--o{ user_data_exports
users |o--o| operators
operators ||--o{ operation_parameter_changes
operators ||--o{ operation_parameters
operators ||--o{ access_grants
users ||--o| access_requests
lead_lists ||--o{ lead_list_members
users ||--o{ lead_list_members
users ||--o{ holder_feedback
users ||--o{ assistant_connections
oauth_clients ||--o{ assistant_connections

users ||--o{ consents
users ||--o{ financial_goals
financial_goals ||--o{ saved_amount_entries
users ||--o{ financial_embeddings
users ||--o{ user_classification_overrides
users ||--o{ periodic_summaries
periodic_summaries ||--o{ summary_documents
users ||--o{ summary_document_receipts
users ||--o| user_data_versions
users ||--o{ budget_alert_states
users ||--o{ signal_states
users ||--o{ financial_write_attempts

users ||--o{ subscriptions
plans ||--o{ subscriptions
plans ||--o{ plan_prices
subscriptions ||--o{ billing_events
users ||--o{ usage_costs
usage_prices ||--o{ usage_costs

campaigns ||--o{ campaign_recipients
users ||--o{ summary_activity
users ||--o{ summary_conversations
users ||--o{ summary_delivery_receipts
users ||--o{ alert_signals
alert_notifications ||--o{ alert_signals
users ||--o{ alert_notifications
users ||--o| alert_data_versions
users ||--o{ alert_delivery_receipts
@enduml
