@startuml UC03 - Metas Financeiras e Resumos Periodicos
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam shadowing false
skinparam dpi 150

actor "Usuário" as U
actor "Sistema\n(Scheduler)" as SYS

rectangle "Metas e Resumos Periódicos" {
    usecase "Definir meta\nfinanceira" as UC18
    usecase "Acompanhar progresso\nde meta" as UC19
    usecase "Editar meta\nfinanceira" as UC20
    usecase "Cancelar ou apagar\nmeta financeira" as UC21
    usecase "Receber resumo\nsemanal" as UC22
    usecase "Receber resumo\nmensal" as UC23
    usecase "Abrir resumo\ncom valores (PIN)" as UC24
    usecase "Receber relatório\ndo período em PDF" as UC25
    usecase "Configurar\npreferências de aviso" as UC26
    usecase "Ativar ou desativar\ntipo de resumo" as UC27
}

U --> UC18
U --> UC19
U --> UC20
U --> UC21
U --> UC24
U --> UC26
U --> UC27

SYS --> UC22 : segunda-feira, 9h
SYS --> UC23 : dia 1, 9h

UC20 ..> UC18 : <<extend>>
UC21 ..> UC18 : <<extend>>

UC24 ..> UC22 : <<extend>>
UC24 ..> UC23 : <<extend>>
UC24 ..> UC25 : <<include>>

UC27 ..> UC26 : <<extend>>

note right of UC22
  Adesão explícita, desativado
  de fábrica. O aviso não contém
  valores, percentuais nem
  categorias.
end note

note right of UC18
  Teto de gasto, saldo em conta,
  patrimônio ou valor guardado.
end note
@enduml
