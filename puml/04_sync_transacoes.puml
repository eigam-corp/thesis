@startuml 04 - Sincronizacao de Transacoes via Open Finance
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180

participant "BullMQ\n(Scheduler)" as BQ
participant "Finance Service" as FS
participant "Pluggy API\n(Open Finance)" as PL
participant "MongoDB" as MG
participant "PostgreSQL" as PG
participant "OpenAI\n(Embeddings)" as AI
participant "pgvector" as VEC
participant "Kafka\ntransactions.sync" as KT
participant "Kafka\nalerts.trigger" as KAL
participant "Kafka\naudit.log" as KA

BQ -> FS : Job "pluggy:sync:{user_id}"\n(cron a cada 6h, distribuído)

FS -> PG : SELECT consents WHERE\nuser_id = ? AND status = 'active'\nAND expires_at > NOW()
PG --> FS : pluggy_item_id, scope[]

alt Consentimento expirado
    FS -> PG : UPDATE consents SET status = 'expired'
    FS -> KA : Produz audit.log\n(operation: consent_expired)
    FS --> BQ : Job finalizado (sem sync)
end

FS -> PL : GET /items/{item_id}/transactions\n(paginação: limit 500, TLS 1.2+)
note right of PL : Retry: 3 tentativas\nbackoff: 1s, 4s, 16s

PL --> FS : Lista de transações brutas

loop Para cada transação recebida
    FS -> MG : SELECT por pluggy_transaction_id\n(verificação de duplicata)
    MG --> FS : resultado

    alt Transação nova
        FS -> FS : Classifica categoria via\nregra MCC ou LLM
        FS -> FS : Criptografa campos sensíveis:\namount_encrypted = AES-256-GCM(amount)\ndescription_encrypted = AES-256-GCM(desc)\nDEK = HKDF(MASTER_KEY, user_id)
        FS -> MG : INSERT transaction\n(campos criptografados + iv + tag)
        MG --> FS : _id inserido
    end
end

FS -> KT : Produz transactions.sync\n(user_id, count, status: completed)

== Detecção de anomalias ==

FS -> MG : Agrega gastos por categoria\n(30 dias, descriptografa em memória)
MG --> FS : Médias e desvios por categoria

FS -> FS : Calcula z-score por categoria\nAnomalia se desvio > 2σ

alt Anomalia detectada
    FS -> KAL : Produz alerts.trigger\n(tipo: overspend, criptografado)
end

FS -> MG : Verifica saldo projetado\n(regressão linear 4 semanas)
MG --> FS : Projeção de saldo

alt Projeção indica saldo negativo em 7 dias
    FS -> KAL : Produz alerts.trigger\n(tipo: low_balance, criptografado)
end

== Geração de embeddings para RAG ==

FS -> FS : Gera resumo textual agregado\n(sem valores monetários individuais)\nEx: "Alimentação subiu 35% em maio,\n47 transações"
FS -> AI : POST /embeddings\n(texto do resumo)
AI --> FS : Vector [1536 dims]

FS -> VEC : INSERT financial_embeddings\n(user_id, content_text, embedding,\nperiod_start, period_end)
VEC --> FS : id inserido

FS -> KA : Produz audit.log\n(operation: pluggy_sync,\ntransactions_synced: N)
@enduml
